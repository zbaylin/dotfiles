include $HOME/Development/dotfiles/wm-common/config

# Start XDG autostart .desktop files using dex.
exec --no-startup-id dex --autostart --environment i3

bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle
bindsym XF86AudioPause exec --no-startup-id playerctl pause

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# Screenshot shortcut
bindsym Control+Shift+4 exec --no-startup-id maim --select | xclip -selection clipboard -t image/png

bindsym $mod+Shift+V exec --no-startup-id pavucontrol
bindsym $mod+Shift+A exec --no-startup-id rofi -show drun

# Lock shortcut
bindsym Control+$mod+Delete exec --no-startup-id i3lock -c 1F1F28

# Configure monitors
exec_always --no-startup-id $HOME/.screenlayout/monitors.sh

# Start polybar
exec_always --no-startup-id $HOME/.config/polybar/launch.sh

# Set wallpaper
exec_always --no-startup-id feh --bg-fill --force-alias $HOME/Pictures/Wallpapers/current

# Set keyrepeat settings
exec_always --no-startup-id xset r rate 200 35
