include $HOME/Development/dotfiles/wm-common/config
include $HOME/Development/dotfiles/sway/local/*.swayconfig

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY \
	DISPLAY \
	SWAYSOCK \
	XDG_CURRENT_DESKTOP \
	XDG_SESSION_TYPE \
	XDG_SESSION_DESKTOP \
	DESKTOP_SESSION

input type:keyboard {
    repeat_delay 250
    repeat_rate 40
}

bindsym $mod+Tab workspace back_and_forth
bindsym $mod+Shift+Tab workspace next_on_output

bindsym $mod+Alt+Delete exec --no-startup-id swaylock -f

# Scratchpad
bindsym $mod+Shift+minus move scratchpad
bindsym $mod+minus scratchpad show

exec_always --no-startup-id swaybg -i $HOME/Development/dotfiles/wallpaper
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

for_window [class="."] inhibit_idle fullscreen
for_window [app_id="."] inhibit_idle fullscreen

bindsym $mod+Shift+e exec swaynag -t \
	warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' \
	-B 'Yes, exit sway' 'swaymsg exit'

exec swayidle -w \
	timeout 300 'swaymsg "output * power off"' \
	resume 'swaymsg "output * power on"' \
	timeout 600 'swaylock -f' \
	before-sleep 'swaylock -f'

bar swaybar_command waybar
